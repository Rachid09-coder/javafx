<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            styleClass="main-container"
            fx:controller="com.edusmart.controller.teacher.ManageExamsController">

    <left>
        <VBox styleClass="sidebar">
            <VBox styleClass="sidebar-logo" spacing="2">
                <Label text="EduSmart" styleClass="sidebar-logo-text"/>
                <Label text="Espace Enseignant" styleClass="sidebar-logo-subtitle"/>
            </VBox>

            <VBox styleClass="sidebar-nav" VBox.vgrow="ALWAYS">
                <Label text="MENU" styleClass="sidebar-section-label"/>
                <Button text="Tableau de bord" styleClass="nav-button" onAction="#handleDashboard"/>
                <Button text="Gerer les Cours" styleClass="nav-button" onAction="#handleManageCourses"/>
                <Button text="Gerer les Modules" styleClass="nav-button" onAction="#handleManageModules"/>
                <Button text="Gerer Examens" styleClass="nav-button active" onAction="#handleManageExams"/>
                <Button text="Notes" styleClass="nav-button" onAction="#handleGradeManagement"/>
                <Button text="Boutique" styleClass="nav-button" onAction="#handleShopManagement"/>
                <Button text="Bulletins" styleClass="nav-button" onAction="#handleBulletins"/>
                <Button text="Certifications" styleClass="nav-button" onAction="#handleCertifications"/>
                <Button text="Analyse AI" styleClass="nav-button" onAction="#handleAnalysisAI"/>
                <Button text="Gestion des Eleves" styleClass="nav-button" onAction="#handleStudentManagement"/>
            </VBox>

            <VBox styleClass="sidebar-footer">
                <Button text="Deconnexion" styleClass="nav-button" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="content-area" spacing="16">
            <HBox alignment="CENTER_LEFT" spacing="12">
                <VBox HBox.hgrow="ALWAYS" spacing="2">
                    <Label text="Gestion des Examens" styleClass="page-title"/>
                    <Label text="Creation, publication et correction des examens" styleClass="page-subtitle"/>
                </VBox>
                <ComboBox fx:id="statusFilterComboBox" prefWidth="150" promptText="Statut"/>
                <TextField fx:id="searchField" promptText="Rechercher..." prefWidth="240"
                           styleClass="search-bar" onAction="#handleSearch"/>
                <Button text="Actualiser" styleClass="btn-secondary" onAction="#handleRefresh"/>
            </HBox>

            <HBox alignment="CENTER_LEFT" spacing="8">
                <Button text="Gestion &amp; Publication" styleClass="btn-primary"/>
                <Button text="Correction &amp; IA" styleClass="btn-secondary" onAction="#handleExamGrading"/>
                <Button text="Generation QCM" styleClass="btn-secondary" onAction="#handleGenerateAiQuiz"/>
            </HBox>

            <FlowPane hgap="8" vgap="8">
                <Button text="Ajouter" styleClass="btn-primary" onAction="#handleAdd"/>
                <Button text="Modifier" styleClass="btn-secondary" onAction="#handleEdit"/>
                <Button text="Supprimer" styleClass="btn-danger" onAction="#handleDelete"/>
                <Button text="Voir PDF" styleClass="btn-secondary" onAction="#handleViewPdf"/>
                <Button text="Publier" styleClass="btn-purple" onAction="#handlePublish"/>
                <Button text="Correction" styleClass="btn-success" onAction="#handleCorrection"/>
            </FlowPane>

            <Label fx:id="messageLabel" visible="false" managed="false" wrapText="true"/>

            <SplitPane dividerPositions="0.68" VBox.vgrow="ALWAYS">
                <TableView fx:id="examsTable" minWidth="520" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="idColumn" text="ID" prefWidth="55"/>
                        <TableColumn fx:id="titleColumn" text="Titre" prefWidth="190"/>
                        <TableColumn fx:id="typeColumn" text="Type" prefWidth="90"/>
                        <TableColumn fx:id="subjectColumn" text="Sujet" prefWidth="130"/>
                        <TableColumn fx:id="statusColumn" text="Statut" prefWidth="115"/>
                        <TableColumn fx:id="durationColumn" text="Duree" prefWidth="80"/>
                        <TableColumn fx:id="semesterColumn" text="Sem." prefWidth="65"/>
                        <TableColumn fx:id="coefficientColumn" text="Coeff." prefWidth="75"/>
                    </columns>
                    <placeholder>
                        <Label text="Aucun examen"/>
                    </placeholder>
                </TableView>

                <ScrollPane fitToWidth="true"
                            minWidth="320"
                            prefWidth="360"
                            style="-fx-background-color: transparent; -fx-background: transparent;">
                    <VBox spacing="12" styleClass="card">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>

                        <Label text="Formulaire Examen" styleClass="section-title"/>

                        <VBox spacing="5">
                            <Label text="Titre *" styleClass="form-label"/>
                            <TextField fx:id="titleField" promptText="Titre de l'examen"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Type *" styleClass="form-label"/>
                            <ComboBox fx:id="typeComboBox" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Duree (minutes)" styleClass="form-label"/>
                            <TextField fx:id="durationField" promptText="ex: 90"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Categorie note" styleClass="form-label"/>
                            <ComboBox fx:id="gradeCategoryComboBox" maxWidth="Infinity"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Description" styleClass="form-label"/>
                            <TextArea fx:id="descriptionArea" promptText="Description..." prefHeight="90" wrapText="true"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Annee academique" styleClass="form-label"/>
                            <TextField fx:id="academicYearField" promptText="ex: 2025/2026"/>
                        </VBox>

                        <HBox spacing="8">
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Semestre" styleClass="form-label"/>
                                <TextField fx:id="semesterField" promptText="ex: 1"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label text="Coefficient" styleClass="form-label"/>
                                <TextField fx:id="coefficientField" promptText="ex: 2"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="5">
                            <Label text="Chemin fichier" styleClass="form-label"/>
                            <TextField fx:id="filePathField" promptText="file_path"/>
                        </VBox>

                        <VBox spacing="5">
                            <Label text="Lien externe" styleClass="form-label"/>
                            <TextField fx:id="externalLinkField" promptText="external_link"/>
                        </VBox>

                        <HBox spacing="8">
                            <Button text="Creer" onAction="#handleCreate" styleClass="btn-primary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                            <Button text="Modifier" onAction="#handleUpdate" styleClass="btn-secondary" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        </HBox>
                        <Button text="Effacer" onAction="#handleClear" styleClass="btn-secondary" maxWidth="Infinity"/>
                    </VBox>
                </ScrollPane>
            </SplitPane>
        </VBox>
    </center>
</BorderPane>
