<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/21"
            styleClass="exam-management-root"
            fx:controller="com.edusmart.controller.teacher.ManageExamsController">

    <left>
        <VBox styleClass="exam-sidebar">
            <VBox styleClass="exam-sidebar-brand" spacing="6">
                <Label text="▱ EduSmart" styleClass="exam-sidebar-logo"/>
                <Label text="Espace Enseignant" styleClass="exam-sidebar-subtitle"/>
            </VBox>

            <VBox styleClass="exam-sidebar-nav" VBox.vgrow="ALWAYS">
                <Label text="NAVIGATION" styleClass="exam-sidebar-section"/>
                <Button text="⌂  Tableau de bord" styleClass="exam-nav-button active" onAction="#handleDashboard"/>
                <Button text="▥  Gérer les Cours" styleClass="exam-nav-button" onAction="#handleManageCourses"/>
                <Button text="▣  Gérer les Modules" styleClass="exam-nav-button" onAction="#handleManageModules"/>
                <Button text="▰  Gérer Examens" styleClass="exam-nav-button" onAction="#handleManageExams"/>
                <Button text="☷  Boutique" styleClass="exam-nav-button" onAction="#handleShopManagement"/>
                <Button text="▥  Bulletins" styleClass="exam-nav-button" onAction="#handleBulletins"/>
                <Button text="♕  Certifications" styleClass="exam-nav-button" onAction="#handleCertifications"/>
                <Button text="☸  Analyse AI" styleClass="exam-nav-button" onAction="#handleAnalysisAI"/>
                <Button text="♟  Gestion des Élèves" styleClass="exam-nav-button" onAction="#handleStudentManagement"/>
            </VBox>

            <VBox styleClass="exam-sidebar-footer">
                <Button text="▮  Déconnexion" styleClass="exam-nav-button" onAction="#handleLogout"/>
            </VBox>
        </VBox>
    </left>

    <center>
        <VBox styleClass="exam-page">
            <HBox styleClass="exam-header" alignment="CENTER_LEFT" spacing="20">
                <VBox HBox.hgrow="ALWAYS">
                    <Label text="Gestion des Examens" styleClass="exam-title"/>
                    <Label text="Cycle de vie complet : Création, Correction, Publication" styleClass="exam-subtitle"/>
                </VBox>

                <ComboBox fx:id="statusFilterComboBox" prefWidth="150" prefHeight="50" styleClass="exam-filter"/>
                <TextField fx:id="searchField" promptText="Rechercher..." prefWidth="260" prefHeight="38"
                           styleClass="exam-search" onAction="#handleSearch"/>
                <VBox alignment="CENTER_RIGHT" spacing="2">
                    <Label text="Enseignant" styleClass="exam-user-name"/>
                    <Label text="Online" styleClass="exam-user-status"/>
                </VBox>
                <Region styleClass="exam-avatar"/>
            </HBox>

            <VBox styleClass="exam-content" VBox.vgrow="ALWAYS">
                <HBox styleClass="exam-tabs" alignment="CENTER_LEFT">
                    <Button text="▰  Gestion &amp; Publication" styleClass="exam-tab active"/>
                    <Button text="☸  Correction &amp; IA" styleClass="exam-tab" onAction="#handleExamGrading"/>
                    <Button text="☸  Génération QCM" styleClass="exam-tab" onAction="#handleGenerateAiQuiz"/>
                </HBox>

                <HBox styleClass="exam-toolbar" alignment="CENTER_LEFT" spacing="10">
                    <Button text="+ Ajouter" styleClass="exam-action-button primary" onAction="#handleAdd"/>
                    <Button text="☞ Modifier" styleClass="exam-action-button outline" onAction="#handleEdit"/>
                    <Button text="▣ Supprimer" styleClass="exam-action-button danger" onAction="#handleDelete"/>
                    <Button text="▣ Voir PDF" styleClass="exam-action-button outline" onAction="#handleViewPdf"/>
                    <Button text="☞ Publier" styleClass="exam-action-button purple" onAction="#handlePublish"/>
                    <Button text="♣ Correction" styleClass="exam-action-button success" onAction="#handleCorrection"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button text="↻ Actualiser" styleClass="exam-action-button outline" onAction="#handleRefresh"/>
                </HBox>

                <Label fx:id="messageLabel" visible="false" managed="false" wrapText="true" styleClass="exam-message"/>

                <HBox spacing="16" VBox.vgrow="ALWAYS">
                    <TableView fx:id="examsTable" HBox.hgrow="ALWAYS" styleClass="exam-table">
                        <columns>
                            <TableColumn fx:id="idColumn" text="ID" prefWidth="50"/>
                            <TableColumn fx:id="titleColumn" text="Titre" prefWidth="185"/>
                            <TableColumn fx:id="typeColumn" text="Type" prefWidth="95"/>
                            <TableColumn fx:id="subjectColumn" text="Sujet" prefWidth="110"/>
                            <TableColumn fx:id="statusColumn" text="Statut" prefWidth="105"/>
                            <TableColumn fx:id="durationColumn" text="Durée" prefWidth="80"/>
                            <TableColumn fx:id="semesterColumn" text="Sem." prefWidth="65"/>
                            <TableColumn fx:id="coefficientColumn" text="Coeff." prefWidth="75"/>
                        </columns>
                        <columnResizePolicy>
                            <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                        </columnResizePolicy>
                        <placeholder>
                            <Label text="Aucun examen"/>
                        </placeholder>
                    </TableView>

                    <VBox styleClass="exam-form-panel" spacing="12" minWidth="320" prefWidth="340" maxWidth="360">
                        <Label text="Formulaire Examen" styleClass="exam-form-title"/>

                        <VBox spacing="4">
                            <Label text="Titre *" styleClass="form-label"/>
                            <TextField fx:id="titleField" promptText="Titre de l'examen" styleClass="text-field"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Type *" styleClass="form-label"/>
                            <ComboBox fx:id="typeComboBox" maxWidth="Infinity" styleClass="combo-box"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Durée (minutes)" styleClass="form-label"/>
                            <TextField fx:id="durationField" promptText="ex: 90" styleClass="text-field"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Catégorie note" styleClass="form-label"/>
                            <ComboBox fx:id="gradeCategoryComboBox" maxWidth="Infinity" styleClass="combo-box"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Description" styleClass="form-label"/>
                            <TextArea fx:id="descriptionArea" promptText="Description..." styleClass="text-area" prefHeight="76" wrapText="true"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Année académique" styleClass="form-label"/>
                            <TextField fx:id="academicYearField" promptText="ex: 2025/2026" styleClass="text-field"/>
                        </VBox>

                        <HBox spacing="8">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Semestre" styleClass="form-label"/>
                                <TextField fx:id="semesterField" promptText="ex: 1" styleClass="text-field"/>
                            </VBox>
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <Label text="Coefficient" styleClass="form-label"/>
                                <TextField fx:id="coefficientField" promptText="ex: 2" styleClass="text-field"/>
                            </VBox>
                        </HBox>

                        <VBox spacing="4">
                            <Label text="Chemin fichier" styleClass="form-label"/>
                            <TextField fx:id="filePathField" promptText="file_path" styleClass="text-field"/>
                        </VBox>

                        <VBox spacing="4">
                            <Label text="Lien externe" styleClass="form-label"/>
                            <TextField fx:id="externalLinkField" promptText="external_link" styleClass="text-field"/>
                        </VBox>

                        <HBox spacing="8">
                            <Button text="Créer" onAction="#handleCreate" styleClass="exam-action-button primary" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                            <Button text="Modifier" onAction="#handleUpdate" styleClass="exam-action-button outline" HBox.hgrow="ALWAYS" maxWidth="Infinity"/>
                        </HBox>
                        <Button text="Effacer" onAction="#handleClear" styleClass="exam-action-button outline" maxWidth="Infinity"/>
                    </VBox>
                </HBox>
            </VBox>
        </VBox>
    </center>
</BorderPane>
