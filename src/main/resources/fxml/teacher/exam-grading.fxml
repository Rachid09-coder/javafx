<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<StackPane xmlns="http://javafx.com/javafx/21"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="com.edusmart.controller.teacher.ExamGradingController"
           styleClass="main-container">

    <VBox styleClass="content-area" spacing="16">
        <HBox alignment="CENTER_LEFT" spacing="12">
            <VBox HBox.hgrow="ALWAYS" spacing="2">
                <Label text="Correction &amp; IA" styleClass="page-title"/>
                <Label text="Correction automatique, detection de plagiat et notification des etudiants" styleClass="page-subtitle"/>
            </VBox>
            <Label fx:id="statusLabel" visible="false" styleClass="form-label"/>
        </HBox>

        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label text="Examen" styleClass="form-label"/>
            <ComboBox fx:id="examComboBox" prefWidth="260" onAction="#handleExamSelected"/>
            <Label text="Question" styleClass="form-label"/>
            <ComboBox fx:id="questionComboBox" prefWidth="280" onAction="#handleQuestionSelected"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button text="Rapport PDF" onAction="#handleGeneratePdfReport" styleClass="btn-secondary"/>
            <Button text="Comparer selection" onAction="#handleCompareSelected" styleClass="btn-purple"/>
            <Button text="Tout corriger" onAction="#handleAiGradeAll" styleClass="btn-primary"/>
        </HBox>

        <SplitPane dividerPositions="0.34" VBox.vgrow="ALWAYS">
            <VBox spacing="10" styleClass="card">
                <padding>
                    <Insets top="16" right="16" bottom="16" left="16"/>
                </padding>
                <Label text="Copies des etudiants" styleClass="section-title"/>
                <TableView fx:id="submissionsTable" VBox.vgrow="ALWAYS" styleClass="table-view">
                    <columns>
                        <TableColumn fx:id="colStudentName" text="Etudiant" prefWidth="145"/>
                        <TableColumn fx:id="colStatus" text="Statut" prefWidth="105"/>
                        <TableColumn fx:id="colScore" text="Note" prefWidth="70"/>
                        <TableColumn fx:id="colPlagiarism" text="Plagiat" prefWidth="80"/>
                    </columns>
                    <placeholder>
                        <Label text="Selectionnez un examen pour voir les copies"/>
                    </placeholder>
                </TableView>
            </VBox>

            <ScrollPane fitToWidth="true" style="-fx-background: transparent; -fx-background-color: transparent;">
                <VBox spacing="14">
                    <VBox spacing="10" styleClass="card">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <HBox alignment="CENTER_LEFT" spacing="12">
                            <Label fx:id="lblStudentName" text="-" styleClass="section-title" HBox.hgrow="ALWAYS"/>
                            <Button text="Corriger" onAction="#handleAiGradeSingle" styleClass="btn-primary"/>
                            <Button text="Email" onAction="#handleSendEmail" styleClass="btn-secondary"/>
                        </HBox>
                        <Label fx:id="lblQuestionText" text="Examen complet" wrapText="true" styleClass="form-label"/>
                        <Label text="Reponse de l'etudiant" styleClass="form-label"/>
                        <TextArea fx:id="taStudentAnswer" prefHeight="130" editable="false" wrapText="true"/>
                    </VBox>

                    <VBox spacing="10" styleClass="card">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <Label text="Resultat de la correction IA" styleClass="section-title"/>
                        <HBox spacing="24" alignment="CENTER_LEFT">
                            <VBox spacing="4">
                                <Label text="Note IA" styleClass="form-label"/>
                                <Label fx:id="lblAiScore" text="-" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4F46E5;"/>
                            </VBox>
                            <VBox spacing="5" HBox.hgrow="ALWAYS">
                                <Label fx:id="lblConfidence" text="Confiance IA: -" styleClass="form-label"/>
                                <ProgressBar fx:id="pbAiConfidence" progress="0" maxWidth="Infinity"/>
                            </VBox>
                            <VBox spacing="5">
                                <Label fx:id="lblPlagiarismScore" text="Plagiat: -" styleClass="form-label"/>
                                <ProgressBar fx:id="pbPlagiarism" progress="0" prefWidth="130"/>
                            </VBox>
                        </HBox>
                        <Label text="Feedback IA" styleClass="form-label"/>
                        <TextArea fx:id="taAiFeedback" prefHeight="110" editable="false" wrapText="true"/>
                    </VBox>

                    <VBox spacing="10" styleClass="card">
                        <padding>
                            <Insets top="16" right="16" bottom="16" left="16"/>
                        </padding>
                        <Label text="Correction manuelle" styleClass="section-title"/>
                        <HBox spacing="12" alignment="CENTER_LEFT">
                            <Label text="Note manuelle" styleClass="form-label"/>
                            <TextField fx:id="tfManualScore" prefWidth="110" promptText="Ex: 15.5"/>
                            <Button text="Sauvegarder" onAction="#handleSaveManualScore" styleClass="btn-success"/>
                        </HBox>
                    </VBox>
                </VBox>
            </ScrollPane>
        </SplitPane>
    </VBox>

    <StackPane fx:id="loadingOverlay" visible="false" style="-fx-background-color: rgba(15, 23, 42, 0.45);">
        <VBox alignment="CENTER" spacing="12" styleClass="card">
            <padding>
                <Insets top="24" right="32" bottom="24" left="32"/>
            </padding>
            <ProgressIndicator prefWidth="44" prefHeight="44"/>
            <Label text="Traitement en cours..." styleClass="section-title"/>
        </VBox>
    </StackPane>
</StackPane>
