<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.geometry.Insets?>

<VBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.edusmart.controller.student.UploadExamController"
      spacing="20" alignment="CENTER" style="-fx-background-color: white;">
    
    <padding>
        <Insets top="40" right="40" bottom="40" left="40"/>
    </padding>

    <Label fx:id="examTitleLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #1E293B;"/>
    
    <VBox spacing="10" alignment="CENTER">
        <Label text="Veuillez sélectionner votre copie d'examen (Format PDF uniquement)" 
               style="-fx-text-fill: #64748B;"/>
        
        <HBox spacing="10" alignment="CENTER">
            <TextField fx:id="filePathField" editable="false" prefWidth="300" 
                       promptText="Aucun fichier sélectionné"
                       style="-fx-background-color: #F8FAFC; -fx-border-color: #E2E8F0; -fx-border-radius: 5;"/>
            <Button text="Parcourir..." onAction="#handleBrowse"
                    style="-fx-background-color: #6366F1; -fx-text-fill: white; -fx-cursor: hand;"/>
        </HBox>
    </VBox>

    <HBox spacing="20" alignment="CENTER">
        <Button text="Annuler" onAction="#handleCancel"
                style="-fx-background-color: #EF4444; -fx-text-fill: white; -fx-cursor: hand; -fx-min-width: 100;"/>
        <Button text="Soumettre mon examen" onAction="#handleSubmit"
                style="-fx-background-color: #10B981; -fx-text-fill: white; -fx-cursor: hand; -fx-min-width: 150; -fx-font-weight: bold;"/>
    </HBox>

</VBox>
